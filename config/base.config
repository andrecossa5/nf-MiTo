// base.config

// Profiles
profiles {

  docker {

    conda.enabled = false
    docker.enabled = true
    singularity.enabled = false

    process {
      withLabel: 'maegatk' {
        container = 'acox1/mito-maegatk:2.0.0'
      }
      withLabel: 'mgatk' {
        container = 'acox1/mito-mgatk:2.0.0'
      }
      withLabel: 'redeemv' {
        container = 'acox1/mito-redeemv:2.0.0'
      }
    }

  }

  conda {

    conda.enabled = true
    docker.enabled = false
    singularity.enabled = false

    process {
      withLabel: 'maegatk' { conda = "${projectDir}/envs/maegatk.yml" }
      withLabel: 'mgatk'   { conda = "${projectDir}/envs/mgatk.yml" }
      withLabel: 'redeemv' { conda = "${projectDir}/envs/redeemv.yml" }
    }

  }

  singularity {

    conda.enabled = false
    docker.enabled = false
    singularity.enabled = true

    process {
      withLabel: 'maegatk' {
        container = 'acox1/mito-maegatk:2.0.0'
      }
      withLabel: 'mgatk' {
        container = 'acox1/mito-mgatk:2.0.0'
      }
      withLabel: 'redeemv' {
        container = 'acox1/mito-redeemv:2.0.0'
      }
    }

  }

  // Local executor profile
  local {
    process.executor = 'local'
  }

}

//

// Processes
process {

  withName: MERGE_R1 {
    cpus = 4
    memory = { 1.GB * task.attempt }
  }
  withName: MERGE_R2 {
    cpus = 4
    memory = { 1.GB * task.attempt }
  }
  withName: SOLO {
    cpus = 6 
    memory = { 60.GB * task.attempt }
  }
  withName: EXTRACT_FASTA {
    cpus = 1
    memory = 1.GB
  }
  withName: SPLIT_BATCHES {
    cpus = 1
    memory = { 4.GB * task.attempt }
  }
  withName: FILTER_MAESTER_BAM {
    cpus = 4
    memory = { 5.GB * task.attempt }
  }
  withName: MAEGATK {
    cpus = 1
    memory = { 2.GB * task.attempt }
  }
  withName: COLLAPSE_MAEGATK {
    cpus = 1
    memory = { 1.GB * task.attempt }
  }
  withName: REDEEM_CONSENSUS {
    cpus = 2
    memory = { 4.GB * task.attempt }
  }
  withName: FINALIZE_REDEEM {
    cpus = 1
    memory = { 8.GB * task.attempt }
  }
  withName: FETCH_MULTIOME_WHITELISTS {
    cpus = 1
    memory = { 1.GB * task.attempt }
  }
  withName: RNA2ATAC_BARCODES {
    cpus = 1
    memory = { 4.GB * task.attempt }
  }
  withName: MERGE_ATAC_LANES {
    cpus = 1
    memory = { 2.GB * task.attempt }
  }
  withName: ATAC_ADD_BARCODE {
    cpus = 1
    memory = { 4.GB * task.attempt }
  }
  withName: BWAMEM2_INDEX {
    cpus = 4
    memory = { 80.GB * task.attempt }
  }
  withName: BWAMEM2_MT {
    cpus = 16
    memory = { 40.GB * task.attempt }
  }
  withName: MGATK {
    cpus = 1
    memory = { 4.GB * task.attempt }
  }
  withName: COLLAPSE_MGATK {
    cpus = 1
    memory = { 2.GB * task.attempt }
  }
  withName: FETCH_WHITELIST {
    cpus = 1
    memory = { 1.GB * task.attempt }
  }
  withName: PREP_GTF {
    cpus = 1
    memory = { 1.GB * task.attempt }
  }
  withName: BUILD_INDEX {
    cpus = 8
    memory = { 50.GB * task.attempt }
  }
  withName: VALIDATE_INDEX {
    cpus = 1
    memory = { 1.GB * task.attempt }
  }

}

// Tracing
trace {
  enabled = true
  file = "trace.txt"
  overwrite = true
}

//