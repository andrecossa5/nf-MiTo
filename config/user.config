// user.config

def ENV = System.getenv()
def SCRATCH_ROOT = ENV.get('NXF_SCRATCH') ?: ENV.get('APPTAINER_TMPDIR') ?: ENV.get('TMPDIR') ?: '/tmp'
def SIF_CACHE    = ENV.get('APPTAINER_CACHEDIR') ?: "${ENV.get('HOME')}/.cache/apptainer"

// Global process settings
process {  

  // Fast scratch enabled
  scratch = false
  errorStrategy = 'retry'
  maxRetries    = 3
  
  beforeScript = """
    mkdir -p ${SCRATCH_ROOT}/tmp \\
             ${SCRATCH_ROOT}/xdg \\
             ${SCRATCH_ROOT}/pip \\
             ${SCRATCH_ROOT}/numba \\
             ${SCRATCH_ROOT}/pycache
  """
  environment = [
    'TMPDIR':                "${SCRATCH_ROOT}/tmp",
    'TMP':                   "${SCRATCH_ROOT}/tmp",
    'TEMP':                  "${SCRATCH_ROOT}/tmp",
    'XDG_CACHE_HOME':        "${SCRATCH_ROOT}/xdg",
    'PIP_CACHE_DIR':         "${SCRATCH_ROOT}/pip",
    'NUMBA_CACHE_DIR':       "${SCRATCH_ROOT}/numba",
    'PYTHONPYCACHEPREFIX':   "${SCRATCH_ROOT}/pycache",
  ]


}

// Profile-specific
profiles {

  singularity {

    singularity.cacheDir = SIF_CACHE
    singularity.runOptions = "--bind /hpcnfs -B ${SCRATCH_ROOT}:${SCRATCH_ROOT} -B /dev/shm:/dev/shm"
    singularity.envWhitelist = 'TMPDIR,TMP,TEMP,XDG_CACHE_HOME,PIP_CACHE_DIR,NUMBA_CACHE_DIR,PYTHONPYCACHEPREFIX'

  }

  conda {
    // Environments pre-installed with mamba from envs/*.yml (see README), used instead of the recipes
    process {
      withLabel: maegatk { conda = "/nfs/research/coorenslab/cossa/mambaforge3/envs/mito-maegatk" }
      withLabel: mgatk   { conda = "/nfs/research/coorenslab/cossa/mambaforge3/envs/mito-mgatk" }
      withLabel: redeemv { conda = "/nfs/research/coorenslab/cossa/mambaforge3/envs/mito-redeemv" }
    }
  }

  slurm {

    process {
      executor = 'slurm'
      time     = '4h'
      withName: 'BWAMEM2_INDEX|BWAMEM2_MT|SOLO|BUILD_INDEX' { time = '24h' }
      withName: 'MAEGATK|MGATK|REDEEM_CONSENSUS' { array = 20 }   // per-cell / per-chunk fan-out
    }

    executor {
      queueSize       = 2000
      pollInterval    = '60 sec'
      submitRateLimit = '2/1min'
      perJobMemLimit  = true
    }

  }
  
}


//
