# redeemv image. Environment: envs/redeemv.yml (build from the repository root).
FROM debian:bookworm-slim
LABEL maintainer="andrea.cossa@ieo.it"

RUN apt-get --quiet update --yes \
    && apt-get --quiet install --yes --no-install-recommends ca-certificates build-essential zlib1g-dev wget git procps \
    && rm -rf /var/lib/apt/lists/*

RUN ARCH=$(uname -m) \
    && wget -q https://github.com/conda-forge/miniforge/releases/download/24.11.3-0/Miniforge3-24.11.3-0-Linux-${ARCH}.sh \
    && bash Miniforge3-24.11.3-0-Linux-${ARCH}.sh -b -p /mambaforge \
    && rm Miniforge3-24.11.3-0-Linux-${ARCH}.sh
ENV PATH="/mambaforge/bin/:$PATH"

COPY envs/redeemv.yml /tmp/env.yml
RUN conda env update -n base -f /tmp/env.yml && conda clean --all --yes

# RedeemV, pinned (no licence file: cloned here, not redistributed in nf-MiTo)
ARG REDEEMV_COMMIT=5c34940
RUN git clone https://github.com/chenweng1991/redeemV.git /opt/redeemV \
    && git -C /opt/redeemV checkout ${REDEEMV_COMMIT}
ENV REDEEMV_HOME=/opt/redeemV

# Build (mgatk and maegatk need x86_64): docker build --platform linux/x86_64 -f docker/Dockerfile_redeemv -t acox1/mito-redeemv:2.0.0 .
CMD ["bash"]
