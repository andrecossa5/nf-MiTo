# RedeemV image (ReDeeM): MT reads from the ATAC library are aligned upstream with bwa-mem2 (mito-mgatk image);
# this image runs RedeemV's mitoConsensus.py and the Python finalization. No R.

################################################################

FROM debian:bookworm-slim
LABEL mantainer = "andrea.cossa@ieo.it"

RUN apt-get --quiet update --yes \
    && apt-get --quiet install --yes --no-install-recommends \
      ca-certificates \
      wget \
      git \
      procps \
    && rm -rf /var/lib/apt/lists/*

RUN ARCH=$(uname -m) \
    && wget https://github.com/conda-forge/miniforge/releases/download/24.11.3-0/Miniforge3-24.11.3-0-Linux-${ARCH}.sh \
    && bash Miniforge3-24.11.3-0-Linux-${ARCH}.sh -b -p /mambaforge \
    && rm Miniforge3-24.11.3-0-Linux-${ARCH}.sh
ENV PATH="/mambaforge/bin/:$PATH"

## mitoConsensus.py needs pysam, numpy, pandas, progress; the finalization needs scipy
RUN mamba install --yes -n base -c conda-forge -c bioconda \
      python=3.12 pysam samtools numpy pandas scipy progress \
    && mamba clean --all --yes

## RedeemV, pinned to a commit (the repository has no licence file: it is cloned here, not redistributed in nf-MiTo)
ARG REDEEMV_COMMIT=5c34940
RUN git clone https://github.com/chenweng1991/redeemV.git /opt/redeemV \
    && git -C /opt/redeemV checkout ${REDEEMV_COMMIT}
ENV REDEEMV_HOME=/opt/redeemV

## Build and push:
##   docker build --platform linux/x86_64 -f docker/Dockerfile_redeemv -t acox1/mito-redeemv:2.0.0 docker/
##   docker push acox1/mito-redeemv:2.0.0

CMD [ "bash" ]

#################################################################
