# MiTo image

################################################################

## Debian 12 (bookworm). The Python of the image comes from Miniforge below, so the base needs no Python.
## (The former python:3.9-bullseye base can no longer be built: Debian 11's package archive is gone.)
FROM debian:bookworm-slim

## Change as u want
LABEL mantainer = "andrea.cossa@ieo.it"

## Compilers and utilities (cassiopeia-mt, a MiTo dependency, builds C++ extensions)
RUN apt-get --quiet update --yes \
    && apt-get --quiet install --yes --no-install-recommends \
      ca-certificates \
      libcurl4-openssl-dev \
      libssl-dev \
      libxml2-dev \
      build-essential \
      zlib1g-dev \
      wget \
      procps \
      cmake \
    && rm -rf /var/lib/apt/lists/*

## Mamba (the installer matching the machine: x86_64 for the HPC image, aarch64 on Apple silicon)
RUN ARCH=$(uname -m) \
    && wget https://github.com/conda-forge/miniforge/releases/download/24.11.3-0/Miniforge3-24.11.3-0-Linux-${ARCH}.sh \
    && bash Miniforge3-24.11.3-0-Linux-${ARCH}.sh -b -p /mambaforge \
    && rm Miniforge3-24.11.3-0-Linux-${ARCH}.sh
ENV PATH="/mambaforge/bin/:$PATH"

## Numba cache in a writable place (containers may run on a read-only filesystem)
RUN mkdir -p /.numba_cache && chmod 1777 /.numba_cache
ENV NUMBA_CACHE_DIR=/.numba_cache

## MiTo, from PyPI. The legacy API (scmito<2) is what nf-MiTo's scripts call.
## The version is read from the package metadata, not by importing MiTo: the import JIT-compiles with
## numba, which crashes when the x86_64 image is built under QEMU emulation (e.g. on Apple silicon).
## MITO_SOURCE is a pip requirement; a wheel in the build context can be tested with
##   --build-arg MITO_SOURCE=/ctx/<wheel>.whl   (the context is mounted at /ctx)
ARG MITO_SOURCE="scmito==1.0.2"
RUN --mount=type=bind,target=/ctx \
    mamba install --yes -n base python=3.12 \
    && pip install --no-cache-dir "${MITO_SOURCE}" \
    && python -c "import importlib.metadata as m; print('scmito', m.version('scmito'))"

## Build and push (x86_64 for the cluster, whatever the build machine is):
##   docker build --platform linux/x86_64 -f docker/Dockerfile_MiTo -t acox1/mito:1.0.2 docker/
##   docker push acox1/mito:1.0.2

## Default command to initialize the container
CMD [ "bash" ]

#################################################################
