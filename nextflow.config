// Configs
includeConfig 'config/pipeline.info.config'
includeConfig 'config/base.config'

// Parameters (default)
params {

    // Input/Output options
    input = null                  // samplesheet CSV: sample,fastq_dir,bam,cell_barcodes
    assay = "MAESTER"             // MAESTER | mtscATAC | ReDeeM
    output_folder = null
    
    // Reference genome options
    build_STAR_index = true
    prebuilt_STAR_index = null
    reference_genome = "https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_32/GRCh38.p13.genome.fa.gz"
    gtf = "https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_32/gencode.v32.annotation.gtf.gz"
    NUMTs_regions = "https://raw.githubusercontent.com/caleblareau/mitoblacklist/master/combinedBlacklist/hg38.full.blacklist.bed"
    tenx_whitelist = "https://teichlab.github.io/scg_lib_structs/data/10X-Genomics/3M-february-2018.txt.gz"
    string_MT = "chrM"
    
    // Sequencing data preprocessing options
    barcode_tag = "CB"            // cell barcode tag of the MT BAM
    CBs_chunk_size = 3000
    
    // mtscATAC options
    atac_min_mapq = 30            // MAPQ of the MT reads kept after bwa-mem2
    atac_barcode_rule = "auto"    // barcode window in the barcode read: auto | fwd:<offset> | rc:<offset>
    barcode_space = "ATAC"        // barcodes of cell_barcodes: ATAC (as in the reads) | RNA (Cell Ranger ARC, ReDeeM/Multiome)
    multiome_whitelist_rna = "https://raw.githubusercontent.com/chenweng1991/redeemV/5c34940/source/WhiteList_10X_Multiome.RNA"
    multiome_whitelist_atac = "https://raw.githubusercontent.com/chenweng1991/redeemV/5c34940/source/WhiteList_10X_Multiome.ATAC"
    mgatk_keep_duplicates = false
    mgatk_handle_overlap = true
    mgatk_proper_paired = true
    mgatk_umi_tag = ""
    mgatk_base_qual = 0
    mgatk_alignment_quality = 30
    mgatk_NHmax = 1
    mgatk_NMmax = 4

    // RedeemV (ReDeeM) options
    redeem_base_quality = 30
    redeem_strand_bias_p = 0.01             // threshold on the p-value (correction none) or on the Storey q-value (storey)
    redeem_strand_bias_correction = "storey" // storey (as RedeemV) | none (raw binomial p-value)
    redeem_strand_bias_log2fc = 1           // |log2(plus/minus)| above which a biased variant is removed

    // Help
    help = false
    version = false

}


//